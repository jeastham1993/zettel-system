# Chat LLM (also used by Research Agent and KB Health)
# Defaults to Ollama (same URL as embeddings, model llama3.1) — pull the model first:
#   ollama pull llama3.1
# For OpenAI instead, uncomment:
# CONTENTGENERATION__PROVIDER=openai
# CONTENTGENERATION__MODEL=gpt-4o
# CONTENTGENERATION__APIKEY=sk-...

# For Amazon Bedrock instead (ambient AWS credentials):
# CONTENTGENERATION__PROVIDER=bedrock
# CONTENTGENERATION__MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# CONTENTGENERATION__REGION=eu-west-1

# Embedding provider: "ollama" (local, free) or "openai" (cloud, requires API key)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_OLLAMA_URL=http://host.docker.internal:11434

# Uncomment for OpenAI instead of Ollama:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_API_KEY=sk-...

# Uncomment for Amazon Bedrock embeddings (ambient AWS credentials):
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# EMBEDDING_BEDROCK_REGION=eu-west-1

# Optional: OpenTelemetry collector
# Otel__Endpoint=http://otel-collector:4317
