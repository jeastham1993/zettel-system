{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Embedding": {
    "Provider": "ollama",
    "Model": "nomic-embed-text",
    "Dimensions": 768,
    "ApiKey": "",
    "OllamaUrl": "http://localhost:11434",
    "HttpTimeoutSeconds": 300,
    "BedrockRegion": "",
    "MaxInputCharacters": 4000,
    "MaxRetries": 3
  },
  "Search": {
    "SemanticWeight": 0.7,
    "FullTextWeight": 0.3,
    "MinimumSimilarity": 0.5,
    "MinimumHybridScore": 0.1,
    "SuggestionThreshold": 0.3
  },
  "ContentGeneration": {
    "Provider": "ollama",
    "Model": "llama3.1",
    "OllamaUrl": "",
    "Region": "",
    "ApiKey": ""
  },
  "Enrichment": {
    "TimeoutSeconds": 10,
    "MaxRetries": 3
  }
}
